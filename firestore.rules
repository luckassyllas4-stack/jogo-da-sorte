rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function admin() { return request.auth != null && request.auth.token.admin == true; }
    match /appConfig/public { allow read: if true; allow write: if admin(); }
    match /appConfig/private { allow read, write: if admin(); }
    match /users/{uid} {
      allow read: if request.auth.uid == uid || admin();
      allow create: if request.auth.uid == uid && !('role' in request.resource.data) && !('jogadas' in request.resource.data);
      allow update: if request.auth.uid == uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role','jogadas','bloqueado']);
    }
    match /gameResults/{id} { allow read: if admin() || resource.data.uid == request.auth.uid; allow write: if false; }
    match /scratchSessions/{id} { allow read: if request.auth.uid == resource.data.uid; allow write: if false; }
    match /paymentEvents/{id} { allow read: if admin(); allow write: if false; }
    match /adminAuditLogs/{id} { allow read: if admin(); allow write: if false; }
  }
}
